# 模型（Agent 与提示词优化共用；兼容任意 OpenAI 端点）
# 不要把真实 key 提交到仓库，只在运行环境里注入
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=45
# 输出预算：推理模型的思考 token 也计入，2048 以下容易截断 JSON
DEEPSEEK_MAX_TOKENS=4096

# Agent 专用覆盖（未设置时回落到上面的 DEEPSEEK_*）
# FILMLINE_AGENT_API_KEY=
# FILMLINE_AGENT_BASE_URL=https://api.deepseek.com
# FILMLINE_AGENT_MODEL=deepseek-flash
# auto（默认，不发送 thinking 字段，DeepSeek 默认开启）/ enabled / disabled
# 只有 enabled 才会发送 reasoning_effort；关闭思考后后端仍会按官方要求回传历史 reasoning_content
# FILMLINE_AGENT_THINKING=auto
# low / high / max；非法值回落到 high
# FILMLINE_AGENT_REASONING_EFFORT=high
# 上下文占用显示的分母
# FILMLINE_AGENT_CONTEXT_WINDOW=1000000
# FILMLINE_AGENT_MAX_TOKENS=8192
# 流式读取空闲超时（秒）与定时自检间隔（秒）
# FILMLINE_AGENT_TIMEOUT=300
# FILMLINE_AGENT_TICK_SECONDS=300
# 图片传输：auto（优先 Files API，失败回退 base64）/ inline / files
# FILMLINE_AGENT_IMAGE_MODE=auto
# Files API 文件有效期（天，1–30）
# FILMLINE_AGENT_FILE_EXPIRY_DAYS=30

# 参考生成（Ref2VA）可选覆盖：显存不足时可回退到 fp8 权重
# FILMLINE_REF_UNET=minimax_h3_ref2va_pruned_int8_convrot.safetensors
# FILMLINE_REF_SHORT_EDGE=768
# FILMLINE_REF_SCHEDULER=simple
# FILMLINE_VIDEO_TIMEOUT=7200
# FILMLINE_COMFY_URL=http://127.0.0.1:8188
